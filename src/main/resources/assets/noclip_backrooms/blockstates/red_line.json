{
  "multipart": [
    {
      "apply": { "model": "noclip_backrooms:block/field/red_line_dot" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "noclip_backrooms:block/field/red_line_side" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "noclip_backrooms:block/field/red_line_side", "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "noclip_backrooms:block/field/red_line_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "noclip_backrooms:block/field/red_line_side", "y": 270 }
    }
  ]
}
